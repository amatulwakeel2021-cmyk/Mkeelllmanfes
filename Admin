<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Inbox Pesan</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">

  <div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Inbox Pesan Masuk (Admin Only)</h1>
      <span class="bg-green-100 text-green-800 text-xs font-semibold px-2.5 py-0.5 rounded">Terautentikasi</span>
    </div>

    <!-- Container Pesan -->
    <div class="space-y-4" id="inboxList">
      
      <!-- Contoh Kartu Pesan Masuk -->
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
        <div class="flex justify-between text-xs text-gray-400 mb-2">
          <span>Pengirim: Anonim #102</span>
          <span>10 Menit yang lalu</span>
        </div>
        
        <p class="text-gray-800 mb-4">"Halo admin, ini pesan rahasia dari penggemar rahasia!"</p>

        <!-- Lampiran Foto jika ada -->
        <div class="mb-3">
          <p class="text-xs font-semibold text-gray-500 mb-1">Lampiran Foto:</p>
          <img src="https://via.placeholder.com/150" alt="Foto Kiriman" class="w-32 h-32 object-cover rounded-lg border">
        </div>

        <!-- Lampiran Suara jika ada -->
        <div>
          <p class="text-xs font-semibold text-gray-500 mb-1">Lampiran Suara:</p>
          <audio controls class="w-full max-w-md h-10">
            <source src="#" type="audio/mp3">
            Browser Anda tidak mendukung elemen audio.
          </audio>
        </div>
      </div>

    </div>
  </div>

</body>
</html>
